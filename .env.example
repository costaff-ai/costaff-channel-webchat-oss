# =============================================================================
# CoStaff — Webchat Channel Configuration
# =============================================================================
# Instructions:
#   1. Copy this file to .env  →  cp .env.example .env
#   2. Fill in all [REQUIRED] fields with your own values
#   3. ID_SALT must match the value in your core CoStaff .env
#
# Quick way to generate a strong secret:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# =============================================================================


# -----------------------------------------------------------------------------
# WEBCHAT SECURITY  [REQUIRED]
# -----------------------------------------------------------------------------

# JWT secret for webchat session tokens — use a long random string (32+ chars).
# Refusing to start the app with the placeholder below is intentional.
WEBCHAT_JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET


# -----------------------------------------------------------------------------
# CORE CONNECTION  [REQUIRED — must match core CoStaff .env]
# -----------------------------------------------------------------------------

# Must match ADK_SESSION_SERVICE_URI in core .env. Form:
#   postgresql+asyncpg://<db-user>:<db-password>@<host>:<port>/<database>
# Substitute your own credentials — do NOT ship the placeholder password.
ADK_SESSION_SERVICE_URI=postgresql+asyncpg://<db-user>:<db-password>@postgres:5432/<db-name>

# Must match ID_SALT in core .env — same value for consistent user identity
ID_SALT=REPLACE_WITH_A_RANDOM_STRING


# -----------------------------------------------------------------------------
# GENERAL  [OPTIONAL]
# -----------------------------------------------------------------------------

# Language for agent responses (e.g. "Traditional Chinese (繁體中文)", "English")
COSTAFF_PREFERRED_LANGUAGE=Traditional Chinese (繁體中文)

# Comma-separated list of allowed origins for browser CORS. Defaults to
# "*" if unset — fine for a local demo, but tighten in production.
# Example:
#   WEBCHAT_ALLOWED_ORIGINS=https://chat.example.com,https://app.example.com
WEBCHAT_ALLOWED_ORIGINS=*
