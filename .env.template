# =============================================================================
# CoStaff — Webchat Channel Configuration
# =============================================================================
# Instructions:
#   1. Copy this file to .env  →  cp .env.template .env
#   2. Fill in all [REQUIRED] fields
#   3. ID_SALT must match the value in your core CoStaff .env
# =============================================================================


# -----------------------------------------------------------------------------
# WEBCHAT SECURITY  [REQUIRED]
# -----------------------------------------------------------------------------

# JWT secret for webchat session tokens — use a long random string (32+ chars)
WEBCHAT_JWT_SECRET=change-me-to-a-long-random-secret


# -----------------------------------------------------------------------------
# CORE CONNECTION  [REQUIRED — must match core CoStaff .env]
# -----------------------------------------------------------------------------

# Must match ADK_SESSION_SERVICE_URI in core .env
ADK_SESSION_SERVICE_URI=postgresql+asyncpg://costaff:costaff_pass@postgres:5432/costaff_db

# Must match ID_SALT in core .env — same value for consistent user identity
ID_SALT=change-me-to-a-random-string


# -----------------------------------------------------------------------------
# GENERAL  [OPTIONAL]
# -----------------------------------------------------------------------------

# Language for agent responses (e.g. "Traditional Chinese (繁體中文)", "English")
COSTAFF_PREFERRED_LANGUAGE=Traditional Chinese (繁體中文)
