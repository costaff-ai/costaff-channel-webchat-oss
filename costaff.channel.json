{
  "name": "webchat",
  "version": "0.1.0",
  "description": "CoStaff 官方網頁對話介面，提供無需通訊軟體的直接瀏覽器存取功能。",
  "a2a_service": "webchat",
  "port": 80,
  "public_port": 18088,
  "env_required": [
    "WEBCHAT_JWT_SECRET",
    "ID_SALT"
  ],
  "env_optional": [
    "WEBCHAT_PORT",
    "WEBCHAT_TOKEN_EXPIRE_MINUTES",
    "WEBCHAT_ALLOWED_ORIGINS",
    "ADK_API_BASE_URL",
    "ADK_APP_NAME",
    "ADK_SESSION_SERVICE_URI",
    "COSTAFF_PREFERRED_LANGUAGE"
  ],
  "health_path": "/.well-known/agent-card.json"
}
